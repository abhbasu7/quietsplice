{
  "manifest_version": 3,
  "name": "QuietSplice — Ad Skip & Mute",
  "version": "1.3.3",
  "description": "Skip available YouTube ads, mute detected YouTube and HBO Max ads, and skip HBO intros with clear status notices.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ad-audio.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.max.com/*",
        "https://*.hbomax.com/*"
      ],
      "js": [
        "ad-audio.js",
        "hbo-intro.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "QuietSplice — Ad Skip & Mute",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "homepage_url": "https://github.com/abhbasu7/quietsplice"
}
